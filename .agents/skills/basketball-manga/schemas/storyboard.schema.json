{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BasketballMangaStoryboard",
  "description": "Structured manga storyboard generated by Gemini 4 Carbon following the basketball-manga skill.",
  "type": "object",
  "required": [
    "story_id",
    "title",
    "subtitle",
    "summary",
    "style",
    "reading_direction",
    "chapters",
    "pages",
    "source_clips"
  ],
  "properties": {
    "story_id": { "type": "string" },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "summary": { "type": "string" },
    "style": {
      "type": "string",
      "enum": ["authentic_sports_manga", "hyperkinetic_shonen_anime", "cinematic_anime_drama"]
    },
    "reading_direction": {
      "type": "string",
      "enum": ["rtl", "ltr"]
    },
    "source_clips": {
      "type": "array",
      "items": { "type": "string" }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chapter_id", "number", "title", "arc_summary"],
        "properties": {
          "chapter_id": { "type": "string" },
          "number": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "arc_summary": { "type": "string" }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "page_id",
          "chapter_id",
          "page_number",
          "page_type",
          "layout_template",
          "panels"
        ],
        "properties": {
          "page_id": { "type": "string" },
          "chapter_id": { "type": "string" },
          "page_number": { "type": "integer", "minimum": 1 },
          "page_type": {
            "type": "string",
            "enum": ["normal", "action", "dialogue", "dramatic", "splash"]
          },
          "layout_template": {
            "type": "string",
            "enum": [
              "balanced_four",
              "balanced_five",
              "dramatic_three",
              "hero_action_four",
              "climax_showcase_three",
              "vertical_strip_four",
              "full_splash"
            ]
          },
          "panels": {
            "type": "array",
            "minItems": 1,
            "maxItems": 7,
            "items": {
              "type": "object",
              "required": [
                "panel_id",
                "reading_order",
                "source_clip_id",
                "source_timestamp",
                "narrative_stage",
                "narrative_beat",
                "camera_shot",
                "emotion",
                "size",
                "layout",
                "description",
                "visual_effects",
                "dialogue",
                "illustration",
                "interaction"
              ],
              "properties": {
                "panel_id": { "type": "string" },
                "reading_order": { "type": "integer", "minimum": 1 },
                "source_clip_id": { "type": "string" },
                "source_timestamp": { "type": "number", "minimum": 0 },
                "narrative_stage": {
                  "type": "string",
                  "enum": ["introduction", "rising_action", "conflict", "climax", "resolution"]
                },
                "narrative_beat": { "type": "string" },
                "character_ids": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "camera_shot": {
                  "type": "string",
                  "enum": [
                    "extreme_closeup",
                    "closeup",
                    "medium_shot",
                    "wide_shot",
                    "low_angle",
                    "high_angle",
                    "dutch_angle",
                    "behind_player",
                    "dynamic_action"
                  ]
                },
                "emotion": {
                  "type": "string",
                  "enum": ["determination", "shock", "triumph", "exhaustion", "defeat", "focus"]
                },
                "size": {
                  "type": "string",
                  "enum": ["small", "medium", "large", "splash"]
                },
                "layout": {
                  "type": "object",
                  "required": ["x", "y", "width", "height"],
                  "properties": {
                    "x": { "type": "number", "minimum": 0, "maximum": 1 },
                    "y": { "type": "number", "minimum": 0, "maximum": 1 },
                    "width": { "type": "number", "minimum": 0.05, "maximum": 1 },
                    "height": { "type": "number", "minimum": 0.05, "maximum": 1 }
                  }
                },
                "description": { "type": "string" },
                "visual_effects": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "caption": { "type": ["string", "null"] },
                "sfx": { "type": ["string", "null"] },
                "sfx_subtext": { "type": ["string", "null"] },
                "dialogue": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["speaker", "text", "bubble_type", "placement"],
                    "properties": {
                      "speaker": { "type": "string" },
                      "text": { "type": "string" },
                      "bubble_type": {
                        "type": "string",
                        "enum": ["speech", "shout", "thought", "narration", "scoreboard", "time_indicator"]
                      },
                      "placement": {
                        "type": "string",
                        "enum": ["top_right", "top_left", "bottom_right", "bottom_left", "top_center", "bottom_center"]
                      }
                    }
                  }
                },
                "illustration": {
                  "type": "object",
                  "required": ["renderer", "style", "prompt"],
                  "properties": {
                    "renderer": {
                      "type": "string",
                      "enum": ["hybrid", "svg_vector", "frame_guided"]
                    },
                    "reference_frame_ids": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "style": { "type": "string" },
                    "prompt": { "type": "string" },
                    "asset_url": { "type": ["string", "null"] },
                    "svg_asset_url": { "type": ["string", "null"] }
                  }
                },
                "interaction": {
                  "type": "object",
                  "required": ["type", "clip_id", "timestamp"],
                  "properties": {
                    "type": { "type": "string", "enum": ["play_source_clip"] },
                    "clip_id": { "type": "string" },
                    "timestamp": { "type": "number", "minimum": 0 },
                    "end_timestamp": { "type": "number", "minimum": 0 },
                    "game_clock": { "type": ["string", "null"] }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
